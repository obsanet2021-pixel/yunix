# Supabase project (same one Yunix's frontend uses)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — NEVER the anon key, and NEVER commit this.
# Find it in Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The Supabase auth.users.id this server is scoped to (personal mode).
# SELECT id FROM auth.users WHERE email = 'you@example.com';
YUNIX_USER_ID=your-supabase-auth-user-id

# stdio (local/Claude Desktop) or http (remote connector for claude.ai)
TRANSPORT=http
PORT=3000
